# Banco de dados (PostgreSQL produção)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/rdo_enterprise"

# Para protótipo local com SQLite, use:
# DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"

# SharePoint (Microsoft Graph API)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
SHAREPOINT_SITE_ID=""
SHAREPOINT_DRIVE_ID=""

# Opcional: URL base das pastas de fotos no SharePoint
SHAREPOINT_FOTOS_BASE_PATH="/sites/obras/Shared Documents/RDO-Fotos"
